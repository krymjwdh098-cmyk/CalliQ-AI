# TalentAI — Environment Configuration

# App
APP_NAME=TalentAI
BASE_URL=http://localhost:8000
ENVIRONMENT=development
DEBUG=true
UPLOAD_DIR=uploads

# Database
DATABASE_URL=sqlite:///./talentai.db
# PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/talentai_db

# Security
SECRET_KEY=change-this-to-random-64-chars-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Redis + Celery (optional — sync fallback if not set)
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1

# LLM Provider: groq | openai | anthropic | gemini | ollama
LLM_PROVIDER=groq

# Groq (fast + cheap — recommended)
GROQ_API_KEY=gsk_your_key_here
GROQ_API_KEYS=gsk_key1,gsk_key2   # multiple keys for rotation
GROQ_MODEL=openai/gpt-oss-120b

# OpenAI (optional)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude (optional)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Gemini (optional)
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-1.5-flash

# Per-agent provider override
PARSER_PROVIDER=groq
MATCHER_PROVIDER=groq
CHAT_PROVIDER=groq

# Score thresholds for auto-categorization
SCORE_STRONG_MATCH=80.0
SCORE_POTENTIAL_MATCH=60.0
SCORE_WEAK_MATCH=40.0

# Batch processing
BATCH_MAX_CONCURRENT=5
BATCH_RETRY_ATTEMPTS=3

# WhatsApp (optional)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=talentai_verify
